    { "id": "skycutter-zephras-dalaran", "kind": "boat", "name": "Skycutter from Zephras Isle to Dalaran",
      "a": { "zone": 16593, "x": 65.8, "y": 83.8 }, "b": { "zone": 36, "x": 12.8, "y": 51.2 },
